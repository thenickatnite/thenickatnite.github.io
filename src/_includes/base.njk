<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} :: {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="stylesheet" href="/assets/css/site.css">
  {%- if site.cfAnalyticsToken %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfAnalyticsToken }}"}'></script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <p class="site-title"><a href="/">{{ site.title }}</a></p>
    <p class="tagline">~ est. 2024, rebuilt 2026 ~</p>
  </header>

  <nav class="site-nav" aria-label="Main">
    <ul>
      {%- for item in site.nav %}
      <li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
    </ul>
  </nav>

  <main id="main" class="window">
    <h1>{{ title }}</h1>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p class="counter">You are visitor #<span class="digits">000042</span></p>
    <p>Last updated {{ buildDate | isoDate }} &middot; Chicago</p>
  </footer>
</body>
</html>
