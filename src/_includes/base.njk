<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} :: {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/site.css">
  {%- if site.cfAnalyticsToken %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfAnalyticsToken }}"}'></script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <p class="site-title"><a href="/">{{ site.title }}</a></p>
    <p class="tagline">~ est. 2024, rebuilt 2026 ~</p>
  </header>

  <nav class="site-nav" aria-label="Main">
    <ul>
      {%- for item in site.nav %}
      <li><a class="button" href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
    </ul>
  </nav>

  <main id="main" class="window">
    <div class="title-bar">
      <h1>{{ title }}</h1>
      {% windowControls %}
    </div>
    <div class="window-body">
      {{ content | safe }}
    </div>
  </main>

  <footer class="taskbar">
    <a class="button start" href="/"><img src="/assets/img/favicon.svg" alt="" width="16" height="16"> Start</a>
    <p class="counter">You are visitor #<span class="digits">000042</span></p>
    <p class="tray">Chicago &middot; <time datetime="{{ buildDate | isoDate }}">updated {{ buildDate | isoDate }}</time></p>
  </footer>
</body>
</html>
