// Cloudflare Worker that serves the built site as static assets (no Worker code).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nickbrown-live",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "nickbrown.live", "custom_domain": true }
  ],
  // Production lives only on the custom domain. PR previews use per-version
  // workers.dev URLs, which need preview_urls switched on explicitly.
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": false }
}
